# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=threatintel
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ransomware.live PRO API
RL_BASE=https://api-pro.ransomware.live
RL_TOKEN=your_ransomware_live_token

# abuse.ch (ThreatFox)
ABUSECH_KEY=your_key_here

# NVD (CVE enrichment)
NVD_KEY=your_key_here
NVD_LIMIT=20

# IOC Enrichment
ABUSEIPDB_KEY=your_key_here
SHODAN_KEY=your_key_here
ENRICH_BATCH=50
SHODAN_BATCH=30

# Additional IOC enrichment
VT_API_KEY=your_key_here
VT_BATCH=4
GREYNOISE_API_KEY=your_key_here
GREYNOISE_BATCH=7

# MITRE ATT&CK Enterprise TAXII/STIX (no key required)
MITRE_ATTACK_SYNC=true

# SIEM ingestion (generate a long random local token; never commit the real value)
SIEM_INGEST_TOKEN=replace_with_a_long_random_token
SIEM_API_URL=http://127.0.0.1:8006/siem/ingest

# Auth (generated by setup_admin.py)
ADMIN_USER=your_admin_username
ADMIN_PASS_HASH=bcrypt_hash_here
MFA_SECRET=totp_secret_here
MFA_ENABLED=true
JWT_SECRET=random_secret_here

# API read-only DB user
API_DB_USER=ti_readonly
API_DB_PASSWORD=your_readonly_password

#!/usr/bin/env python3
"""Wazuh Integrator adapter for the ThreatIntel SIEM ingestion endpoint."""

import json
import sys
import urllib.error
import urllib.request


def main():
    if len(sys.argv) < 4:
        print("custom-threatintel requires alert_file, api_key, and hook_url", file=sys.stderr)
        return 2

    alert_file, token, endpoint = sys.argv[1:4]
    if not token or not endpoint:
        print("custom-threatintel token or endpoint is missing", file=sys.stderr)
        return 2

    with open(alert_file, "r", encoding="utf-8") as handle:
        event = json.load(handle)

    body = json.dumps({"source": "wazuh", "event": event}).encode("utf-8")
    request = urllib.request.Request(
        endpoint,
        data=body,
        headers={
            "Content-Type": "application/json",
            "X-SIEM-Token": token,
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            result = json.loads(response.read().decode("utf-8"))
        print(
            f"ThreatIntel accepted event {result.get('event_id')} "
            f"with {result.get('match_count', 0)} match(es)"
        )
        return 0
    except (urllib.error.URLError, urllib.error.HTTPError, ValueError) as exc:
        print(f"ThreatIntel forwarding failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
